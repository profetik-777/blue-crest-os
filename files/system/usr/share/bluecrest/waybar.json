{
  "layer": "top",
  "position": "top",
  "height": 30,
  "spacing": 6,
  "modules-left": [
    "custom/settings",
    "sway/workspaces",
    "sway/mode"
  ],
  "modules-center": [
    "clock"
  ],
  "modules-right": [
    "cpu",
    "memory",
    "disk",
    "pulseaudio",
    "network",
    "battery",
    "tray"
  ],
  "custom/settings": {
    "format": "Settings",
    "tooltip": false,
    "on-click": "bluecrest-settings",
    "on-click-right": "bluecrest-shortcuts"
  },
  "sway/workspaces": {
    "disable-scroll": true,
    "all-outputs": false,
    "persistent-workspaces": {
      "1": [],
      "2": [],
      "3": []
    }
  },
  "pulseaudio": {
    "format": "Vol {volume}%",
    "format-muted": "Muted",
    "on-click": "pavucontrol",
    "on-click-right": "pactl set-sink-mute @DEFAULT_SINK@ toggle"
  },
  "network": {
    "format-wifi": "Wi-Fi {signalStrength}%",
    "format-ethernet": "Wired",
    "format-disconnected": "Offline",
    "tooltip-format": "{ifname}: {ipaddr}",
    "on-click": "nm-connection-editor",
    "interval": 10
  },
  "battery": {
    "format": "Bat {capacity}%",
    "format-charging": "Charging {capacity}%",
    "states": {
      "warning": 25,
      "critical": 10
    },
    "interval": 30
  },
  "clock": {
    "format": "{:%a %b %d  %I:%M %p}",
    "tooltip-format": "{:%A, %B %d, %Y}"
  },
  "tray": {
    "spacing": 8
  },
  "fixed-center": true,
  "memory": {
    "interval": 5,
    "format": "RAM {percentage}%",
    "tooltip-format": "{used:.1f} / {total:.1f} GiB used",
    "states": {
      "warning": 75,
      "critical": 90
    }
  },
  "disk": {
    "interval": 30,
    "path": "/var/home",
    "format": "Storage {percentage_used}%",
    "tooltip-format": "{used} / {total} used on {path} ({free} free)",
    "states": {
      "warning": 80,
      "critical": 95
    }
  },
  "cpu": {
    "interval": 3,
    "format": "CPU {usage}%",
    "tooltip-format": "CPU usage: {usage}%",
    "states": {
      "warning": 75,
      "critical": 90
    }
  }
}
